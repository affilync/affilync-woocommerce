<?xml version="1.0"?>
<ruleset name="Affilync WooCommerce Plugin">
    <description>PHP CodeSniffer configuration for Affilync WooCommerce plugin.</description>

    <!-- Scan these files -->
    <file>affilync-woocommerce.php</file>
    <file>includes/</file>

    <!-- Exclude vendor and test directories -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>assets/js/*.min.js</exclude-pattern>

    <!-- Use WordPress-Extra standard (includes WordPress-Core + best practices) -->
    <rule ref="WordPress-Extra">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- WordPress documentation standards -->
    <rule ref="WordPress-Docs"/>

    <!-- Check for PHP cross-version compatibility (PHP 7.4+) -->
    <config name="minimum_supported_wp_version" value="5.8"/>
    <config name="testVersion" value="7.4-"/>

    <!-- Text domain for i18n -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="affilync-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Prefixes for functions, classes, hooks -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="affilync"/>
                <element value="Affilync"/>
                <element value="AFFILYNC"/>
            </property>
        </properties>
    </rule>

    <!-- Allow file names that don't match WP conventions for class files -->
    <rule ref="WordPress.Files.FileName">
        <properties>
            <property name="strict_class_file_names" value="false"/>
        </properties>
    </rule>

    <!-- Show colors and progress -->
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Use PSR-12 as a baseline where WordPress standard doesn't cover -->
    <arg name="extensions" value="php"/>

    <!-- Line length: warn at 120, error at 200 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="200"/>
        </properties>
    </rule>
</ruleset>
